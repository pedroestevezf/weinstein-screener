//@version=5
indicator("Weinstein Screener - Etapa 1 (MA30 semanal)", overlay=true)

// Parámetros ajustables desde la UI de TradingView -- ambos "a validar en
// backtest" según el documento de diseño (sección 3): distancia entre 5-10%,
// pendiente entre 3-5 semanas de retroceso.
distancePct   = input.float(7.5, "Distancia máxima a la MA30 semanal (%)", minval=0.1, maxval=50, step=0.5)
slopeLookback = input.int(4, "Semanas de retroceso para la pendiente", minval=1, maxval=52)
maLength      = input.int(30, "Longitud de la media móvil (semanas)", minval=1)

// Se piden explícitamente en resolución semanal ("W") dentro de la misma
// llamada a request.security, para que el desplazamiento [slopeLookback]
// se evalúe en semanas reales -- si se aplicara ese desplazamiento FUERA de
// request.security, sobre una serie ya devuelta al timeframe del gráfico,
// contaría barras del gráfico (p.ej. días), no semanas. lookahead_off evita
// que el indicador "vea" datos de la semana en curso antes de que cierre.
[weeklyClose, ma30w, ma30wPrior] = request.security(
     syminfo.tickerid, "W",
     [close, ta.sma(close, maLength), ta.sma(close, maLength)[slopeLookback]],
     lookahead=barmerge.lookahead_off)

maSlopePositive   = ma30w > ma30wPrior
distancePctValue  = math.abs(weeklyClose - ma30w) / ma30w * 100
withinDistance    = distancePctValue <= distancePct

candidate = withinDistance and maSlopePositive

plot(ma30w, title="MA30 semanal", color=color.blue)
plot(distancePctValue, title="Distancia a MA30 (%)")
plotchar(candidate, title="Candidato Etapa 1", char="●", location=location.belowbar, color=color.lime, size=size.tiny)

// Para usar con el Pine Screener de TradingView: aplicar este indicador
// sobre el universo deseado (NYSE+Nasdaq, Eurostoxx) y filtrar/ordenar por
// las columnas "Distancia a MA30 (%)" (<= distancePct) y "Candidato Etapa 1"
// (true). Exportar el resultado a CSV manualmente cada semana -- ver
// weinstein_screener/screener_import.py para el paso siguiente.
